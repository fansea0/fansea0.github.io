// 飞书 Wiki 风格的布局与配色
//
// 结构:顶栏(.wiki-topbar) + 左侧目录树(.wiki-sidebar) + 内容区(.wiki-main)
// 颜色统一走 CSS 变量,深浅色各一套,和主题原有的 color-scheme.css 对齐。

:root[color-mode="light"] {
  --wiki-bg: #ffffff;
  --wiki-sidebar-bg: #f7f8fa;
  --wiki-sidebar-active: #e9f0ff;
  --wiki-border: #e5e6eb;
  --wiki-border-strong: #dee0e3;
  --wiki-text: #1f2329;
  --wiki-text-sub: #646a73;
  --wiki-text-3: #8f959e;
  --wiki-accent: #3370ff;
  --wiki-hover: #f2f3f5;
  --wiki-shadow: 0 2px 8px rgba(31, 35, 41, 0.08);
}

:root[color-mode="dark"] {
  --wiki-bg: #2e3440;
  --wiki-sidebar-bg: #272c36;
  --wiki-sidebar-active: rgba(88, 141, 255, 0.18);
  --wiki-border: #3b4252;
  --wiki-border-strong: #434c5e;
  --wiki-text: #eceff4;
  --wiki-text-sub: #b6becb;
  --wiki-text-3: #8a93a3;
  --wiki-accent: #7aa2ff;
  --wiki-hover: rgba(255, 255, 255, 0.06);
  --wiki-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

$wiki-font = -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Helvetica, Arial, sans-serif
$topbar-height = 52px
$sidebar-width = 268px

html, body {
  font-family: $wiki-font;
}

.wiki-app {
  min-height: 100vh;
}

// ---------- 顶栏 ----------

.wiki-topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 16px;
  height: $topbar-height;
  padding: 0 16px;
  background-color: var(--wiki-bg);
  border-bottom: 1px solid var(--wiki-border);
}

.wiki-topbar-left {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.wiki-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--wiki-text);
  font-size: 15px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wiki-logo-icon {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  flex-shrink: 0;
}

.wiki-topbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
  min-width: 0;
}

.wiki-search-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  max-width: 420px;
  height: 32px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 6px;
  background-color: var(--wiki-hover);
  color: var(--wiki-text-3);
  font-size: 13px;
  font-family: $wiki-font;
  cursor: pointer;
  transition: background-color 0.2s ease;

  &:hover {
    background-color: var(--wiki-border);
    color: var(--wiki-text-sub);
  }
}

.wiki-topbar-right {
  display: flex;
  align-items: center;
  gap: 6px;
}

.wiki-top-link {
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 13px;
  color: var(--wiki-text-sub);

  &:hover {
    background-color: var(--wiki-hover);
    color: var(--wiki-text);
  }
}

.wiki-icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border: none;
  border-radius: 6px;
  background-color: transparent;
  color: var(--wiki-text-sub);
  cursor: pointer;

  &:hover {
    background-color: var(--wiki-hover);
    color: var(--wiki-text);
  }
}

.wiki-menu-btn {
  display: none;
}

.wiki-theme-btn {
  .wiki-theme-icon-dark {
    display: none;
  }
}

:root[color-mode="dark"] .wiki-theme-btn {
  .wiki-theme-icon-light {
    display: none;
  }
  .wiki-theme-icon-dark {
    display: inline-flex;
  }
}

.wiki-avatar {
  display: block;
  width: 30px;
  height: 30px;
  margin-left: 4px;
  border-radius: 50%;
  overflow: hidden;

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
}

// ---------- 主体 ----------

.wiki-body {
  display: flex;
  align-items: flex-start;
  min-height: calc(100vh - 52px);
}

.wiki-sidebar {
  position: sticky;
  top: $topbar-height;
  flex-shrink: 0;
  width: $sidebar-width;
  height: calc(100vh - 52px);
  padding: 12px 8px 40px;
  background-color: var(--wiki-sidebar-bg);
  border-right: 1px solid var(--wiki-border);
  overflow-y: auto;
  overscroll-behavior: contain;
}

.wiki-sidebar-head {
  padding: 4px 8px 10px;
}

.wiki-sidebar-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--wiki-text-sub);
  letter-spacing: 0.02em;
}

.wiki-scrim {
  display: none;
}

// ---------- 目录树 ----------

.wiki-tree-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.wiki-tree-list .wiki-tree-list {
  padding-left: 14px;
}

.wiki-node-row {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 32px;
  padding: 0 8px 0 2px;
  border-radius: 6px;
  color: var(--wiki-text);
  cursor: pointer;

  &:hover {
    background-color: var(--wiki-hover);

    .wiki-node-name {
      color: var(--wiki-text);
    }
  }
}

.wiki-node-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  padding: 0;
  border: none;
  border-radius: 4px;
  background-color: transparent;
  color: var(--wiki-text-3);
  cursor: pointer;

  .wiki-icon-chevron {
    transition: transform 0.15s ease;
  }
}

.wiki-node-toggle-blank {
  cursor: default;
}

.wiki-node.is-open > .wiki-node-row > .wiki-node-toggle .wiki-icon-chevron {
  transform: rotate(90deg);
}

.wiki-node.is-collapsed > .wiki-tree-list {
  display: none;
}

.wiki-node-link {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  min-width: 0;
  color: var(--wiki-text);
  font-size: 14px;
}

.wiki-node-icon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  color: var(--wiki-text-3);
}

.wiki-node-folder > .wiki-node-row > .wiki-node-link > .wiki-node-icon {
  color: #f5a623;
}

.wiki-node-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wiki-node-count {
  flex-shrink: 0;
  font-size: 12px;
  color: var(--wiki-text-3);
}

.wiki-node.is-current > .wiki-node-row {
  .wiki-node-name {
    color: var(--wiki-accent);
    font-weight: 500;
  }
}

// ---------- 内容区 ----------

.wiki-main {
  flex: 1;
  min-width: 0;
  padding-bottom: 60px;
}

.wiki-page {
  max-width: 920px;
  margin: 0 auto;
  padding: 28px 40px 0;
}

.wiki-main > .container {
  width: auto;
  max-width: 920px;
  margin: 0 auto;
  padding: 28px 40px 0;
}

.wiki-page-head {
  margin-bottom: 24px;
}

.wiki-page-title {
  margin: 0;
  font-size: 30px;
  font-weight: 600;
  line-height: 1.3;
  color: var(--wiki-text);
}

.wiki-page-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 10px;
  font-size: 13px;
  color: var(--wiki-text-3);
}

.wiki-breadcrumb {
  margin-bottom: 12px;
  font-size: 13px;
  color: var(--wiki-text-3);

  a {
    color: var(--wiki-text-3);

    &:hover {
      color: var(--wiki-accent);
    }
  }
}

.wiki-crumb-sep {
  margin: 0 6px;
  color: var(--wiki-border-strong);
}

.wiki-crumb-current {
  color: var(--wiki-text-sub);
}

// ---------- 区块 ----------

.wiki-section {
  margin-bottom: 32px;
}

.wiki-section-title {
  margin: 0 0 12px;
  font-size: 14px;
  font-weight: 600;
  color: var(--wiki-text-sub);
}

// ---------- 文件夹卡片 ----------

.wiki-folder-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 12px;
}

.wiki-folder-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  border: 1px solid var(--wiki-border);
  border-radius: 10px;
  background-color: var(--wiki-bg);
  color: var(--wiki-text);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;

  &:hover {
    border-color: var(--wiki-accent);
    box-shadow: var(--wiki-shadow);
  }
}

.wiki-folder-card-icon {
  display: inline-flex;
  color: #f5a623;
}

.wiki-folder-card-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.wiki-folder-card-name {
  font-size: 14px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wiki-folder-card-count {
  font-size: 12px;
  color: var(--wiki-text-3);
}

// ---------- 文档列表 ----------

.wiki-doc-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.wiki-doc-item {
  border-radius: 8px;

  a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    color: var(--wiki-text);
  }

  &:hover {
    background-color: var(--wiki-hover);
  }
}

.wiki-doc-icon {
  display: inline-flex;
  flex-shrink: 0;
  color: var(--wiki-text-3);
}

.wiki-doc-item-folder .wiki-doc-icon {
  color: #f5a623;
}

.wiki-doc-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-width: 0;
}

.wiki-doc-title {
  font-size: 14px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wiki-doc-desc {
  font-size: 12px;
  color: var(--wiki-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wiki-doc-date {
  flex-shrink: 0;
  font-size: 12px;
  color: var(--wiki-text-3);
}

.wiki-empty {
  padding: 40px 0;
  text-align: center;
  color: var(--wiki-text-3);
  font-size: 14px;
}

// ---------- 文章页 ----------

.wiki-post-layout {
  display: flex;
  align-items: flex-start;
  gap: 40px;
}

.wiki-post-body {
  flex: 1;
  min-width: 0;
}

.wiki-page-meta {
  .post-pubtime,
  .post-tags,
  .post-folders {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
}

.span--tag a,
.span--folder a {
  padding: 2px 8px;
  border-radius: 4px;
  background-color: var(--wiki-hover);
  font-size: 12px;
  color: var(--wiki-text-sub);

  &:hover {
    background-color: var(--wiki-border);
    color: var(--wiki-accent);
  }
}

.span--folder a {
  background-color: var(--wiki-sidebar-active);
  color: var(--wiki-accent);
}

.post-catalog {
  position: sticky;
  top: $topbar-height + 24px;
  flex-shrink: 0;
  width: 220px;
  max-height: calc(100vh - 100px);
  font-size: 13px;
  padding-left: 0;

  .title {
    color: var(--wiki-text-sub);
    font-size: 13px;
    font-weight: 600;
    padding: 5px 0;
  }

  .catalog-content {
    overflow: auto;
  }

  li {
    list-style-type: none;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    line-height: 1.9;
  }
}

.toc-link {
  position: relative;
  display: block;
  padding: 3px 5px;
  border-left: 2px solid transparent;
  opacity: 0.8;
  color: var(--wiki-text-sub);

  &.active {
    color: var(--wiki-accent);
    opacity: 1;
  }
}

.prev-or-next {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 40px;
  padding-top: 16px;
  border-top: 1px solid var(--wiki-border);
  font-size: 14px;
}

.prev-or-next .post-foot-prev,
.prev-or-next .post-foot-next {
  white-space: nowrap;
  min-width: 0;

  a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--wiki-text-sub);

    &:hover {
      color: var(--wiki-accent);
    }
  }
}

.prev-or-next .post-foot-next {
  text-align: right;
}

// ---------- 归档 / 标签页 ----------

.archives .post-item,
.tag-details .post-item {
  border-bottom: 1px solid var(--wiki-border);
  padding: 6px 0;
}

.tag-list li {
  display: inline-block;
  padding: 6px 10px;
  margin: 0 6px 6px 0;
  border-radius: 6px;
  background-color: var(--wiki-hover);
  font-size: 14px;
}

.content-title h2 {
  font-size: 20px;
  color: var(--wiki-text);
  margin: 20px 0 10px;
}

// ---------- 悬浮工具条 ----------

.tools-bar {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.tools-bar .tools-bar-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background-color: var(--wiki-bg);
  border: 1px solid var(--wiki-border);
  box-shadow: var(--wiki-shadow);
  color: var(--wiki-text-sub);

  a {
    display: flex;
    color: inherit;
  }
}

.tools-bar .back-to-top.hidden {
  display: none;
}

// ---------- 搜索弹层 ----------

.search-overlay {
  background-color: rgba(31, 35, 41, 0.45);
}

.search-content {
  top: 12%;
}

.search-title {
  border: 1px solid var(--wiki-border);
  border-radius: 10px;
  background-color: var(--wiki-bg);
  box-shadow: var(--wiki-shadow);
}

.search-input {
  font-family: $wiki-font;
  color: var(--wiki-text);
}

.search-result {
  background-color: var(--wiki-bg);
  border: 1px solid var(--wiki-border);
  border-radius: 10px;
  box-shadow: var(--wiki-shadow);
}

// ---------- 页脚 ----------

.wiki-main .footer {
  max-width: 920px;
  margin: 0 auto;
  padding: 24px 40px 0;
  border-top: 1px solid var(--wiki-border);
  font-size: 12px;
  color: var(--wiki-text-3);
}

// ---------- 移动端 ----------

@media (max-width: 960px) {
  .wiki-menu-btn {
    display: inline-flex;
  }

  .wiki-logo-text {
    display: none;
  }

  .wiki-top-link {
    display: none;
  }

  .wiki-sidebar {
    position: fixed;
    top: $topbar-height;
    left: -($sidebar-width);
    z-index: 120;
    transition: left 0.25s ease;
    box-shadow: var(--wiki-shadow);
  }

  .wiki-sidebar.is-open {
    left: 0;
  }

  .wiki-scrim {
    display: block;
    position: fixed;
    top: $topbar-height;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 110;
    background-color: rgba(31, 35, 41, 0.4);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
  }

  .wiki-scrim.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease;
  }

  .wiki-page,
  .wiki-main > .container {
    padding: 20px 20px 0;
  }

  .wiki-main .footer {
    padding: 20px 20px 0;
  }

  .wiki-page-title {
    font-size: 24px;
  }

  .wiki-post-layout {
    display: block;
  }

  .post-catalog {
    display: none;
  }

  .btn-catalog {
    display: block;
    position: fixed;
    top: $topbar-height + 8px;
    right: 8px;
    z-index: 95;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 8px;
    background-color: var(--wiki-bg);
    border: 1px solid var(--wiki-border);
    box-shadow: var(--wiki-shadow);
    color: var(--wiki-text-sub);
  }

  .post-catalog.hidden {
    display: none;
  }
}
