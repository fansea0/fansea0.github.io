<%# 目录树节点,递归渲染。文件夹可展开收起,文档是叶子 %>
<%
const currentPath = page.path || ''
%>
<ul class="wiki-tree-list">
  <% (nodes || []).forEach(function (node) { %>
    <% if (node.type === 'folder') { %>
      <li class="wiki-node wiki-node-folder<%= node.file === currentPath ? ' is-current' : '' %>" data-folder="<%- node.path %>">
        <div class="wiki-node-row">
          <button class="wiki-node-toggle" type="button" aria-expanded="true" aria-label="展开或收起">
            <%- wikiIcon('chevron') %>
          </button>
          <a class="wiki-node-link" href="<%- url_for(node.url) %>" title="<%- node.name %>">
            <span class="wiki-node-icon"><%- wikiIcon('folder') %></span>
            <span class="wiki-node-name"><%- node.name %></span>
          </a>
          <span class="wiki-node-count"><%- node.total %></span>
        </div>
        <%- partial('wiki-node', { nodes: node.children }) %>
      </li>
    <% } else { %>
      <li class="wiki-node wiki-node-doc<%= node.file === currentPath ? ' is-current' : '' %>" data-doc="<%- node.file %>">
        <div class="wiki-node-row">
          <span class="wiki-node-toggle wiki-node-toggle-blank"></span>
          <a class="wiki-node-link" href="<%- url_for(node.url) %>" title="<%- node.name %>">
            <span class="wiki-node-icon"><%- wikiIcon('doc') %></span>
            <span class="wiki-node-name"><%- node.name %></span>
          </a>
        </div>
      </li>
    <% } %>
  <% }) %>
</ul>
