<%
const wikiCfg = theme.wiki || {}
const siteName = wikiCfg.siteName || config.title
const navItems = (theme.navbar || []).filter(item => item.enable && item.key !== 'home')
%>
<header class="wiki-topbar">
  <div class="wiki-topbar-left">
    <button class="wiki-icon-btn wiki-menu-btn" id="wiki-menu-btn" type="button" aria-label="目录">
      <%- wikiIcon('menu') %>
    </button>
    <a class="wiki-logo" href="<%- url_for('/') %>">
      <img class="wiki-logo-icon" src="<%- theme.favicon.enable ? theme.favicon.icon : '/images/favicon.png' %>" alt="">
      <span class="wiki-logo-text"><%- siteName %></span>
    </a>
  </div>

  <div class="wiki-topbar-center">
    <% if (theme.search.enable) { %>
      <button class="wiki-search-btn" id="search-icon" type="button">
        <%- wikiIcon('search') %>
        <span class="wiki-search-text"><%- theme.search.placeholder || '搜索' %></span>
      </button>
    <% } %>
  </div>

  <div class="wiki-topbar-right">
    <% navItems.forEach(function (item) { %>
      <a class="wiki-top-link" href="<%- url_for(item.path) %>"><%- item.name %></a>
    <% }) %>

    <% if (theme.colorSwitch.enable) { %>
      <button class="wiki-icon-btn wiki-theme-btn" id="switch-color-scheme" type="button" aria-label="切换配色">
        <span class="wiki-theme-icon wiki-theme-icon-light"><%- wikiIcon('moon') %></span>
        <span class="wiki-theme-icon wiki-theme-icon-dark"><%- wikiIcon('sun') %></span>
      </button>
      <%- js(['/js/colorscheme.js']) %>
    <% } %>

    <a class="wiki-avatar" href="<%- url_for(theme.avatar.path) %>" title="<%- theme.avatar.author_nickname %>">
      <img src="<%- theme.avatar.author_photo %>" alt="<%- theme.avatar.author_nickname %>">
    </a>
  </div>
</header>
