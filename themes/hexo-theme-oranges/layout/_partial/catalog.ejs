<% if (theme.catalog.enable && (toc(page.content) || toc(page.origin))) { %>
  <button id="btn-catalog" class="btn-catalog" type="button" aria-controls="catalog" aria-expanded="false">
    <i class="iconfont icon-catalog"></i>
  </button>
  <div class="catalog-backdrop" id="catalog-backdrop"></div>
  <div class="post-catalog hidden" id="catalog">
    <div class="title">
      <span><%= __('catalog') %></span>
      <button class="catalog-close" id="btn-catalog-close" type="button" aria-label="关闭大纲">×</button>
    </div>
    <div class="catalog-content">
      <% if (page.encrypt == true) { %>
        <%- toc(page.origin, { "list_number": false }) %>
      <% } else { %>
        <%- toc(page.content, { "list_number": false }) %>
      <% } %>
    </div>
  </div>

  <%- js(['/js/catalog.js']) %>

<% } %>
